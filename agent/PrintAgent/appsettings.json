{
  "PrintAgent": {
    "PortRange": [8443, 8444, 8445, 8446, 8447],
    "MaxMessageBytes": 20971520,
    "MaxJobsPerConnection": 5,
    "PairingPromptTimeoutSeconds": 60,
    "PairingRefusalCooldownMinutes": 5,
    "AllowInsecureOrigins": false,
    "LogLevel": "Information",
    "Language": "auto",
    "UpdateRepoUrl": "https://github.com/dragonofmercy/web-print-agent",
    "UpdateCheckIntervalHours": 6,
    "UpdateAllowPrerelease": false,
    "UpdateInitialDelaySeconds": 30
  }
}
